<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>8.0.25</RuntimeFrameworkVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- silence hundreds of warning codes that are either
         platform-specific (CA1416) or nullable analysis noise
         originating from large legacy code sections.  They
         can be addressed over time but do not block building. -->
    <NoWarn>CS8618;CS8600;CS8602;CS8603;CS8622;CS8625;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.29.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Exclude duplicate emulator display class file to avoid duplicate type compile errors -->
  <ItemGroup>
    <Compile Remove="Emulation\EmulatorDisplay.cs" />
  </ItemGroup>

  <!-- Exclude duplicate/demo files to reduce duplicate-type compile errors quickly. These are non-destructive exclusions and can be reverted. -->
  <!-- Exclusions were previously added to silence duplicate-type errors during refactoring.
       MainWindow.cs must be included for the WPF UI to appear.  Retain other removals only
       if duplicates still exist, but leave MainWindow enabled. -->
  <ItemGroup>
    <Compile Remove="StandaloneBoltDemo.cs" />
    <Compile Remove="BoltDemo_Standalone\**\*.cs" />
    <Compile Remove="Emulation\HomebrewEmulatorClean.cs" />
    <Compile Remove="Emulation\*Clean.cs" />
    <Page Remove="FolderAnalysisWindow.xaml" />
    <Compile Remove="FolderAnalysisWindow.xaml.cs" />
    <!-- MainWindow.cs restored so the GUI can be constructed -->
  </ItemGroup>

</Project>
